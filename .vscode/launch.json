{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Backend",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/app.js",
      "runtimeExecutable": "/home/undercovered/.nvm/versions/node/v22.12.0/bin/node",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Backend (watch)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/app.js",
      "runtimeExecutable": "/home/undercovered/.nvm/versions/node/v22.12.0/bin/node",
      "runtimeArgs": ["--watch"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "npm run debug (watch)",
      "skipFiles": ["<node_internals>/**"],
      "runtimeExecutable": "/home/undercovered/.nvm/versions/node/v22.12.0/bin/npm",
      "runtimeArgs": ["run", "debug:watch"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to Backend (9229)",
      "skipFiles": ["<node_internals>/**"],
      "port": 9229,
      "restart": true
    }
  ]
}
