# Copia este archivo a `.env` y asigna los valores.

# --- Servidor HTTP ---
PORT=

# --- PostgreSQL ---
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=

# TLS hacia RDS / Aurora (en localhost no hace falta).
# PGSSLMODE=require
# PGSSL_REJECT_UNAUTHORIZED=true
# Si el handshake falla por el CA de Amazon, descarga el bundle RDS o
# deja rejectUnauthorized en false solo mientras pruebas.

# --- Pool de conexiones (opcional) ---
PGPOOL_MAX=
# PGIDLE_TIMEOUT_MS=30000
# PGCONNECTION_TIMEOUT_MS=5000
# Con Aurora Serverless (pausa a 0 ACU) usa timeout de conexión ≥ 20000.

# --- Auth / cifrado ---
# Palabra clave secreta (pepper). Se mezcla con la contraseña ANTES de scrypt.
# Debe ser larga y aleatoria. Si se filtra la base de datos, sin esto no se
# pueden recuperar las contraseñas.
PASSWORD_PEPPER=

# Secreto para firmar las sesiones (JWT HMAC-SHA256).
JWT_SECRET=

# Caducidad del token: 60s, 15m, 12h, 7d (por defecto 7d).
JWT_EXPIRES_IN=7d

