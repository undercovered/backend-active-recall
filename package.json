{
  "name": "active-recall-backend",
  "version": "0.0.1",
  "description": "Backend API for the Active Recall spaced-repetition app",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "debug": "node --inspect app.js",
    "debug:brk": "node --inspect-brk app.js",
    "debug:watch": "node --watch --inspect app.js",
    "test": "node --test --test-concurrency=1 $(find test -name '*.test.js')"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  }
}
